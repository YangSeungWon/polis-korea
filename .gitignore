.env
.env.*
*.log
.DS_Store
__pycache__/
*.pyc
.venv/
node_modules/
.claude/

# raw 데이터 (가공 결과는 커밋)
# 디렉터리 자체가 아닌 "내용물"을 무시해야 아래 예외(!) 재포함이 동작함.
data/raw/*
data/*.csv
data/*.xlsx
data/*.xls

# 예외: 무투표 당선구 캐시 (공개 선거데이터·소량 — 커밋해 키 없이 재현 가능)
!data/raw/nec_uncontested/
# 예외: 후보 정당·직위 캐시 (NEC 후보자검색 결과·공개데이터 — 커밋해 키 없이 재현)
!data/raw/nec_candidate_party.json
!data/raw/nec_candidate_office.json
# 예외: 후보 생년월일·한자 캐시 (같은 출처·같은 이유). 6.9MB로 크지만 이게 없으면
# **CI가 다른 데이터를 만든다** — dob의 1순위 출처라, 빠지면 MONA로 폴백해 9명의
# 생년월일이 달라지고 인물 페이지 slug가 어긋난다. 그러면 regen_check가 영원히
# 실패하고(커밋된 산출물 ≠ 지금 생성한 것), 그 실패가 진짜 회귀를 가린다.
!data/raw/nec_candidate_bio.json
# 예외: NEC 등록후보 명부 (산점도 등록/사전거론 구분용·런타임 fetch·공개데이터)
!data/raw/nec_roster_9th.json
# 예외: 22대 총선 선거구별 후보 명부 (NEC 개표결과 xlsx 추출·공개데이터)
!data/raw/nec_roster_22gen.json
# 예외: raw 카탈로그 — 다른 머신·새 clone에서 재현 가능하도록 manifest 추적
!data/raw/MANIFEST.json
# 예외: VT012 정기조사 목록 — CI cold run이 scrape를 증분으로 시작하게(0부터 재스크랩 방지). tracker 소스 list.
!data/raw/nesdc_etc_polls.csv
*.manual.bak
!data/raw/nec_roster_21gen.json
!data/raw/nec_roster_20gen.json
!data/raw/nec_roster_7th.json
# 예외: NEC 투표구별 선거구→읍면동 매핑 (옛 총선 경계복원 입력·공개데이터·재스크랩 방지)
!data/raw/nec/
# 예외: 5~8회 기초의회 정당 의석 (위키 scrape — 재현 가능하지만 fetch 시간 절약)
!data/raw/5th_council_party_seats.json
!data/raw/6th_council_party_seats.json
!data/raw/7th_council_party_seats.json
!data/raw/8th_council_party_seats.json
# 예외: 의원 unique ID 룩업 (assembly xlsx 파싱 결과 — xlsx는 수동 다운로드)
!data/raw/assembly_member_map.json

# CI 생성물 (src/history/hexgrid.ts → npm run build:map). 커밋 안 함.
assets/hexgrid.js
assets/history/geomap.js

# UI 감사 스크린샷 (로컬 실행 산출물)
ui-shots/

# 캡처 전용 하네스 — build_og_maps가 만들고 지운다. 발행되면 안 된다.
.render/
